% Shared style for all notes. Use with \usepackage{physnotes}.
% build.py puts this folder on TEXINPUTS, so notes anywhere under notes/ find it.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{physnotes}[2026/11/25 Shared style for physics notes]

\RequirePackage[margin=1in]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{physics}   % \dd, \bra, \ket, \braket, \order, \tr, \Tr, \qty, ...
\RequirePackage{slashed}   % \slashed{p}
\RequirePackage{bm}
\RequirePackage{microtype}
\RequirePackage[hidelinks]{hyperref}

% --- macros ---
\newcommand{\ii}{\mathrm{i}}
\newcommand{\Lag}{\mathcal{L}}

% equation numbers restart per section: (2.3)
\numberwithin{equation}{section}
